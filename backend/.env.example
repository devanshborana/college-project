# LMCST Learn - Backend Environment Variables
# Using SQLite for local development, easily switch to PostgreSQL for production
DATABASE_URL=sqlite:///./sql_app.db
# DATABASE_URL=postgresql://user:password@localhost/lmcst_learn

# Security
SECRET_KEY=your-super-secret-jwt-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Environment
ENVIRONMENT=development
# ENVIRONMENT=production
